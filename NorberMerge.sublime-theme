{
"extends": "Norber.sublime-theme",
"variables": {
// --- Shared ---
  "accent_ui_dimmed": "hsl(6, 40%, 48%)",

  "overlay_bg": "hsl(0, 0%, 21%)",

  // Buttons
  "button_bg": "hsl(214, 10%, 34%)",
  "button_hover_bg": "color(var(button_bg) l(+ 7%))",
  "button_pressed_bg": "color(var(button_bg) l(+ 15%))",

  // Labels
  "font_face": "Consolas",
  "font_size": 14,
  "font_size_sm": 11,
  "font_size_lg": 16,

// --- Sublime Merge ---
  // Labels
  "branch_stats_label_bg": "var(medium_gray)",

  // Header
  "header_bg": "hsl(0, 0%, 21%)",

  "info_area_progress_bar_bg": "hsl(0, 0%, 80%)",
  "info_area_progress_bar_fg": "hsl(0, 0%, 53%)",

  "diverged_bg": "color(var(orange) l(- 5%) s(- 20%))",
  "diverged_button_bg": "hsla(210, 10%, 93%, 0.7)",
  "diverged_button_hover_bg": "color(var(diverged_button_bg) l(+ 15%) a(0.9))",
  "diverged_button_fg": "#404040",
  "diverged_icon_bg": "var(orange)",
  "diverged_icon_fg": "color(var(diverged_bg) l(- 30%) s(- 10%))",

  // Tabs
  "content_tab_bg": "var(header_bg)",
  "content_tab_hover_bg": "hsl(0, 0%, 28%)",
  "content_tab_selected_bg": "var(background)",
  "content_tab_fg": "var(foreground)",

  "repository_tab_bar_bg": "hsl(210, 10%, 30%)",

  "file_badge_modified_bg": "hsl(61, 100%, 78%)",
  "file_badge_unmerged_bg": "var(unmerged_header_bg)",
  "file_badge_untracked_bg": "var(detail_panel_bg)",
  "file_badge_staged_bg": "hsl(104, 100%, 86%)",
  "file_badge_modified_fg": "hsl(0, 0%, 13%)",
  "file_badge_unmerged_fg": "hsl(34, 74%, 10%)",
  "file_badge_untracked_fg": "var(medium_gray-dark)",
  "file_badge_staged_fg": "hsl(0, 0%, 13%)",

  "split_button_line": "var(background)",

  "highlighted_button_light_bg": "color(hsl(84, 35%, 50%))",
  "highlighted_button_light_fg": "var(foreground)",
  "highlighted_button_dark_bg": "color(hsl(83, 40%, 44%))",
  "highlighted_button_dark_fg": "var(foreground)",

  // Hazard Buttons
  "hazard_button_bg": "var(red)",

  // Radio Buttons
  "radio_back": "var(background)",
  "radio_selected": "var(blue)",
  "radio_border_unselected": "hsl(0, 0%, 65%)",
  "radio_border_selected": "var(blue)",

  // Checkbox Buttons
  "checkbox_selected": "var(blue)",
  "checkbox_bg": "var(background)",
  "checkbox-disabled": "hsl(0, 0%, 65%)",
  "checkbox_border_unselected": "hsl(0, 0%, 65%)",
  "checkbox_border_selected": "var(blue)",

  // Sidebar
  "sidebar_heading_fg": "hsl(200, 50%, 75%)",

  // Location Bar
  "submodule_stat_bg": "var(orange)",
  "submodule_stat_fg": "white",
  "location_bar_fg": "var(foreground)",
  "location_bar_heading_fg": "var(sidebar_heading_fg)",
  "location_bar_selected_fg": "hsl(50, 100%, 50%)",
  "disclosure_fg": "white",

  // Commit List
  "commit_color_count": 6,
  "commit_edge_0": "var(blue)",
  "commit_edge_1": "var(purple)",
  "commit_edge_2": "var(magenta)",
  "commit_edge_3": "color(var(red) s(70%) l(70%))",
  "commit_edge_4": "color(var(yellow) l(60%) s(75%))",
  "commit_edge_5": "color(var(teal))",

  // Table of Contents (Files)
  "table_of_contents_heading_fg": "var(sidebar_heading_fg)",

  // Annotations
  "commit_annotation_fg": "hsl(204, 100%, 83%)",
  "commit_annotation_fg_inverted": "color(black)",
  "commit_annotation_bg": "var(dark_gray-medium)",

  "commit_annotation_fg_0_border": "var(commit_edge_0)",
  "commit_annotation_fg_1_border": "var(commit_edge_1)",
  "commit_annotation_fg_2_border": "var(commit_edge_2)",
  "commit_annotation_fg_3_border": "var(commit_edge_3)",
  "commit_annotation_fg_4_border": "var(commit_edge_4)",
  "commit_annotation_fg_5_border": "var(commit_edge_5)",

  "commit_annotation_bg_inverted_0": "var(commit_edge_0)",
  "commit_annotation_bg_inverted_1": "var(commit_edge_1)",
  "commit_annotation_bg_inverted_2": "var(commit_edge_2)",
  "commit_annotation_bg_inverted_3": "var(commit_edge_3)",
  "commit_annotation_bg_inverted_4": "var(commit_edge_4)",
  "commit_annotation_bg_inverted_5": "var(commit_edge_5)",

  "tag_annotation_fg": "var(dark_gray)",
  "tag_annotation_bg": "color(var(yellow) a(0.8))",

  "stash_annotation_fg": "var(yellow)",
  "stash_annotation_bg": "color(var(yellow) a(0.3))",

  "file_annotation_fg": "var(foreground)",
  "file_annotation_bg": "color(var(file_annotation_fg) a(0.3))",

  "submodule_annotation_fg": "var(foreground)",
  "submodule_annotation_bg": "var(dark_gray-lightest)",

  "inserted_annotation_bg": "color(var(dark_teal) s(- 10%))",
  "deleted_annotation_bg": "color(var(dark_red) s(- 10%))",

  "submodule_light_annotation_fg": "color(var(foreground) a(0.5))",

  // Detail Panel
  "detail_panel_bg": "var(background)",
  "field_name_fg": "var(foreground)",
  "author_fg": "var(foreground_secondary)",
  "terminator_fg": "var(medium_gray)",

  // Diff Headers
  "expand_all_diff_bg": "var(background)",
  "expand_all_diff_hover_bg": "color(var(expand_all_diff_bg) l(+ 5%))",

  "file_diff_header_bg": "hsl(205, 11%, 24%)",
  "file_diff_header_hover_bg": "color(var(file_diff_header_bg) l(+ 3%))",
  "file_diff_header_fg": "white",

  "hunk_header_bg": "hsl(0, 0%, 19%)",
  "hunk_header_fg": "white",

  "file_icon_bg": "color(white a(0.2))",

  "deleted_icon_fg": "var(foreground)",

  "unmerged_icon_fg": "color(var(foreground) l(+ 20%))",
  "unmerged_header_bg": "hsl(26, 60%, 40%)",
  "unmerged_header_hover_bg": "color(var(unmerged_header_bg) l(+ 5%))",

  "recent_icon_fg": "var(yellow)",
  "recent_icon_bg": "transparent",

  "untracked_header_bg": "hsl(0, 40%, 26%)",
  "untracked_header_hover_bg": "color(var(untracked_header_bg) l(+ 7%))",

  "staged_icon_fg": "var(foreground)",
  "staged_header_bg": "hsl(100, 40%, 24%)",

  "renamed_file_inserted": "color(var(green) s(30%) l(60%))",
  "renamed_file_deleted": "color(var(red) s(50%) l(65%))",

  // Command History
  "command_status_label_ok_fg": "hsl(120, 70%, 70%)",
  "command_status_label_error_fg": "hsl(0, 90%, 70%)",

  // File Diffs
  "onion_skin_slider_puck_bg": "color(var(medium_gray) l(+ 5%))",
  "onion_skin_slider_puck_border_bg": "var(medium_gray-dark)",
  "onion_skin_slider_track_bg": "var(medium_gray-dark)",

  // Image Diffs
  "image_diff_bg": "var(detail_panel_bg)",
  "image_diff_fg": "var(foreground)",
  "image_diff_checkerboard_main_bg": "var(background)",
  "image_diff_checkerboard_alt_bg": "color(var(background) l(- 10%))",
  "image_metadata_label_bg": "var(medium_gray-dark)",

  // Blame
  "blame_popup_bg": "var(overlay_bg)",

  // Dialogs
  "dialog_bg": "var(dark_gray-light)",
  "dialog_button_bg": "var(medium_gray)",

  // Progress Bar
  "progress_bg": "color(var(dark_gray-lightest) l(+ 3%))",
  "progress_fg": "color(var(medium_gray) a(0.5))",

  // Hints
  "hint_bg": "color(var(yellow) l(75%))",
  "hint_fg": "black",

  "success_hint_bg": "var(dialog_bg)",
  "success_hint_fg": "var(foreground)",
  "success_hint_accent": "var(green)",

  "error_hint_bg": "var(hint_bg)",
  "error_hint_fg": "var(hint_fg)",
  "error_hint_accent": "var(orange)",
  "failed_label_bg": "var(orange)",
  "failed_label_fg": "var(dark_gray)",

  // Loading
  "loading_ball_1": "var(medium_gray)",
  "loading_ball_2": "var(blue)",

  // Merge Helper
  "merge_helper_highlight_bg": "color(var(dark_gray-lightest) l(25%))",

  "console_border": "color(var(dark_gray-lightest) l(20%))",

  // Output Status Icon
  "output_fg": "var(foreground)",
  "output_succeeded_fg": "var(green)",
  "output_failed_fg": "hsl(0, 100%, 40%)",
  "output_running_fg": "var(blue)",
  "output_cancelled_fg": "var(foreground)",

  // Focus Highlight
  "focus_highlight_color": "var(foreground)",
},

"rules": [
  // Labels
  {
    "class": "label_control",
    "font.face": "var(font_face)",
    "font.size": "var(font_size)"
  },

  // Browse page
  {
    "class": "console_panel",
    "layer0.tint": "var(console_border)",
    "layer0.opacity": 1.0,
  },
  {
    "class": "panel_grid_control",
    "inside_spacing": 0,
    "outside_vspacing": 4,
  },

  // Focus highlight
  {
    "class": "focus_highlight_control",
    "highlight_color": "color(var(focus_highlight_color) a(0.2))",
    "highlight_border_color": "color(var(focus_highlight_color) a(0.6))",
  },

  // Buttons
  {
    "class": "button_control",
    "content_margin": [14, 0],
    "min_size": [60, 32],
  },
  {
    "class": "button_control",
    "attributes": ["confirm"],
    "layer0.opacity": 0.5,
    "layer0.tint": "color(var(hazard_button_bg) l(+ 12%))",
  },
  {
    "class": "button_control",
    "attributes": ["disabled"],
    "layer0.opacity": 0.3,
  },
  {
    "class": "button_control icon_button",
    "content_margin": 0,
    "min_size": [38, 32],
  },
  {
    "class": "label_control",
    "parents": [{"class": "button_control"}],
    "font.size": 15,
    "font.bold": true
  },
  {
    "class": "label_control",
    "parents": [{"class": "button_control", "attributes": ["disabled"]}],
    "opacity": 0.7,
  },
  {
    "class": "button_control icon_button filter_button",
    "content_margin": 0,
    "min_size": [10, 18],
  },
  {
    "class": "button_control icon_button close_filter",
    "content_margin": 0,
    "min_size": [10, 18],
  },

  // Icons
  {
    "class": "icon_full_context",
    "layer0.texture": "NorberTheme/action_icons/icon_full_context.png",
    "layer0.tint": "var(icon_button_fg)",
    "layer0.opacity": 1.0,
    "layer1.texture": "NorberTheme/action_icons/icon_full_context_enabled.png",
    "layer1.tint": "var(icon_button_fg)",
    "layer1.opacity": 0.0,
    "content_margin": [8, 8, 8, 7],
  },
  {
    "class": "icon_side_bar",
    "layer0.texture": "NorberTheme/action_icons/icon_side_bar.png",
    "layer0.opacity": 1.0,
    "layer0.tint": "var(icon_button_fg)",
    "content_margin": [15, 13],
  },
  {
    "class": "icon_back",
    "layer0.texture": "NorberTheme/action_icons/icon_back.png",
    "layer0.opacity": 1.0,
    "layer0.tint": "var(icon_button_fg)",
    "content_margin": [15, 13],
  },
  {
    "class": "icon_forward",
    "layer0.texture": "NorberTheme/action_icons/icon_forward.png",
    "layer0.opacity": 1.0,
    "layer0.tint": "var(icon_button_fg)",
    "content_margin": [15, 13],
  },
  {
    "class": "icon_stash",
    "layer0.texture": "NorberTheme/action_icons/icon_stash.png",
    "layer0.opacity": 1.0,
    "layer0.tint": "var(icon_button_fg)",
    "content_margin": [15, 13],
  },
  {
    "class": "icon_pop_stash",
    "layer0.texture": "NorberTheme/action_icons/icon_pop_stash.png",
    "layer0.opacity": 1.0,
    "layer0.tint": "var(icon_button_fg)",
    "content_margin": [15, 13],
  },
  {
    "class": "icon_search",
    "layer0.texture": "NorberTheme/action_icons/icon_search.png",
    "layer0.opacity": 1.0,
    "layer0.tint": "var(icon_button_fg)",
    "content_margin": [15, 13],
  },
  {
    "class": "icon_filter",
    "layer0.texture": "NorberTheme/action_icons/icon_filter.png",
    "layer0.opacity": 1.0,
    "layer0.tint": "var(icon_button_fg)",
    "layer1.texture": "NorberTheme/action_icons/icon_filter_outline.png",
    "layer1.opacity": 0.7,
    "layer1.tint": "var(icon_button_fg)",
    "content_margin": [14, 13, 13, 13],
  },
  {
    "class": "icon_more",
    "layer0.texture": "NorberTheme/action_icons/icon_more.png",
    "layer0.opacity": 1.0,
    "layer0.tint": "var(icon_button_fg)",
    "content_margin": [15, 10],
  },
  {
    "class": "icon_more_hunk",
    "layer0.texture": "NorberTheme/action_icons/icon_more.png",
    "layer0.opacity": 1.0,
    "layer0.tint": "var(icon_button_fg)",
    "content_margin": [15, 10],
  },
  {
    "class": "icon_pull",
    "layer0.texture": "NorberTheme/action_icons/icon_pull.png",
    "layer0.opacity": 1.0,
    "layer0.tint": "var(icon_button_fg)",
    "content_margin": [15, 13],
  },
  {
    "class": "icon_push",
    "layer0.texture": "NorberTheme/action_icons/icon_push.png",
    "layer0.opacity": 1.0,
    "layer0.tint": "var(icon_button_fg)",
    "content_margin": [15, 13],
  },
  {
    "class": "icon_options_dropdown",
    "layer0.texture": "NorberTheme/action_icons/icon_options_dropdown.png",
    "layer0.opacity": 1.0,
    "layer0.tint": "var(icon_button_fg)",
    "content_margin": [8, 13],
  },
  {
    "class": "icon_dropdown_button",
    "layer0.texture": "NorberTheme/action_icons/icon_dropdown_button.png",
    "layer0.opacity": 1.0,
    "layer0.tint": "var(icon_button_fg)",
    "content_margin": [9, 8],
  },
  {
    "class": "icon_cancel",
    "layer0.texture": "NorberTheme/action_icons/icon_cancel.png",
    "layer0.opacity": 1.0,
    "layer0.tint": "var(icon_button_fg)",
    "content_margin": [9, 8],
  },
  {
    "class": "icon_repeat",
    "layer0.texture": "NorberTheme/action_icons/icon_repeat.png",
    "layer0.opacity": 1.0,
    "layer0.tint": "var(icon_button_fg)",
    "content_margin": [15, 13],
  },
  {
    "class": "icon_behind",
    "layer0.texture": "NorberTheme/action_icons/icon_behind.png",
    "layer0.tint": "var(file_annotation_fg)",
    "layer0.opacity": 1.0,
    "content_margin": [4, 5, 5, 5],
  },
  {
    "class": "icon_ahead",
    "layer0.texture": "NorberTheme/action_icons/icon_ahead.png",
    "layer0.tint": "var(file_annotation_fg)",
    "layer0.opacity": 1.0,
    "content_margin": [4, 5, 5, 5],
  },
  {
    "class": "icon_visible",
    "layer0.texture": "NorberTheme/action_icons/icon_visible.png",
    "layer0.opacity": 1.0,
    "layer0.tint": "var(icon_button_fg)",
    "content_margin": [8, 5],
  },
  {
    "class": "icon_hidden",
    "layer0.texture": "NorberTheme/action_icons/icon_hidden.png",
    "layer0.opacity": 1.0,
    "layer0.tint": "var(icon_button_fg)",
    "layer1.texture": "NorberTheme/action_icons/icon_hidden_slash.png",
    "layer1.opacity": 1.0,
    "layer1.tint": "var(orange)",
    "content_margin": [8, 5],
  },
  {
    "class": "icon_uninitialized_submodule",
    "layer0.texture": "NorberTheme/action_icons/icon_diverged_filled.png",
    "layer0.opacity": 1.0,
    "layer0.tint": "var(icon_button_fg)",
    "content_margin": [8, 5],
  },
  {
    "class": "icon_section_actions",
    "layer0.texture": "NorberTheme/action_icons/icon_gear.png",
    "layer0.opacity": 1.0,
    "layer0.tint": "var(icon_button_fg)",
    "content_margin": [10, 7],
  },

  // Highlighted Buttons
  {
    "class": "button_control",
    "attributes": ["highlighted"],
    "layer1.tint": "var(highlighted_button_light_bg)",
  },
  {
    "class": "button_control",
    "attributes": ["highlighted", "dark"],
    "layer1.tint": "var(highlighted_button_dark_bg)",
  },
  {
    "class": "button_control icon_button",
    "attributes": ["highlighted"],
    "content_margin": 0,
    "min_size": [10, 27],
  },
  {
    "class": "label_control",
    "parents": [{"class": "button_control", "attributes": ["highlighted"]}],
    "fg": "var(highlighted_button_light_fg)",
  },
  {
    "class": "label_control",
    "parents": [{"class": "button_control", "attributes": ["highlighted", "dark"]}],
    "fg": "var(highlighted_button_dark_fg)",
  },

  // Split Buttons
  {
    "class": "button_control_left",
    "min_size": [100, 24],
  },
  {
    "class": "button_control_right",
    "layer1.texture": "NorberTheme/assets/button_right_line.png",
    "layer1.tint": "var(split_button_line)",
    "layer1.opacity": 0.35,
    "layer1.inner_margin": 4,
    "content_margin": [5, 6],
    "min_size": [20, 24],
  },
  {
    "class": "button_control_right icon_button",
    "content_margin": 0,
    "min_size": [20, 32],
  },
  {
    "class": "button_control_left icon_button",
    "content_margin": 0,
    "min_size": [38, 32],
  },

  // Toggle Buttons
  {
    "class": "toggle_button",
    "min_size": [70, 30],
    "content_margin": [8, 0, 8, 0],

    "layer0.tint": "color(var(button_bg) l(- 5%))",
    "layer0.opacity": 1.0,
    "layer0.inner_margin": 4,
  },
  {
    "class": "toggle_button",
    "attributes": ["selected"],
    "layer0.tint": "var(button_pressed_bg)",
  },

  // Hunk Buttons
  {
    "class": "hunk_button",
    "min_size": [100, 20],
    "content_margin": [14, 4],
  },
  {
    "class": "hunk_button",
    "parents": [{"class": "file_diff_hunk_container", "attributes": ["!hover"]}],
    "attributes": ["!confirm"],
    "layer0.opacity": 0.0,
  },
  {
    "class": "hunk_button",
    "parents": [{"class": "file_diff_hunk_container", "attributes": ["hover"]}],
    "layer0.opacity": 0.6,
  },
  {
    "class": "hunk_button",
    "parents": [{"class": "file_diff_hunk_header", "attributes": ["selected"]}],
    "layer0.opacity": 0.6,
  },
  {
    "class": "hunk_button",
    "parents": [{"class": "file_diff_hunk_container", "attributes": ["hover"]}],
    "attributes": ["hover"],
    "layer0.opacity": 0.8,
  },
  {
    "class": "hunk_button",
    "parents": [{"class": "file_diff_hunk_container", "attributes": ["hover"]}],
    "attributes": ["pressed"],
    "layer0.opacity": 1.0,
  },
  {
    "class": "label_control",
    "parents": [{"class": "file_diff_hunk_container"}, {"class": "hunk_button"}],
    "font.size": 14,
    "shadow_offset": 0
  },
  {
    "class": "label_control",
    "parents": [{"class": "file_diff_hunk_container"}, {"class": "hunk_button", "attributes": ["!confirm"]}],
    "fg": "var(foreground)",
  },
  {
    "class": "label_control",
    "parents": [{"class": "file_diff_hunk_container", "attributes": ["hover"]}, {"class": "hunk_button", "attributes": ["!confirm"]}],
    "fg": "var(foreground)",
  },
  {
    "class": "label_control",
    "parents": [{"class": "file_diff_hunk_header", "attributes": ["selected"]}, {"class": "hunk_button", "attributes": ["!confirm"]}],
    "fg": "var(foreground)",
  },
  {
    "class": "icon_more_hunk",
    "parents": [{"class": "file_diff_hunk_container"}],
    "layer0.opacity": 0.0,
  },
  {
    "class": "icon_more_hunk",
    "parents": [{"class": "file_diff_hunk_container", "attributes": ["hover"]}],
    "layer0.opacity": 1.0,
  },
  {
    "class": "icon_more_hunk",
    "parents": [{"class": "file_diff_hunk_header", "attributes": ["selected"]}],
    "layer0.opacity": 1.0,
  },

  // Checkboxes
  {
    "class": "checkbox_box_control",
    "content_margin": [13, 13, 0, 0],
    "layer0.texture": "NorberTheme/assets/checkbox_back.png",
    "layer0.tint": "var(checkbox_bg)",
    "layer0.opacity": 1.0,
    "layer1.texture": "NorberTheme/assets/checkbox_border.png",
    "layer1.tint": "var(checkbox_border_unselected)",
    "layer1.opacity": 1.0,
    "layer2.texture": "NorberTheme/assets/checkbox_check.png",
    "layer2.tint": "var(checkbox_selected)",
    "layer2.opacity": 0,
  },
  {
    "class": "checkbox_box_control",
    "parents": [{"class": "checkbox_control", "attributes": ["checked"]}],
    "layer1.tint": "var(checkbox_border_selected)",
    "layer2.opacity": 1.0,
  },
  {
    "class": "checkbox_box_control",
    "parents": [{"class": "checkbox_control", "attributes": ["disabled"]}],
    "layer2.texture": "NorberTheme/assets/checkbox_disabled.png",
    "layer2.tint": "var(checkbox-disabled)",
    "layer2.opacity": 1.0,
  },

  // Radio Buttons
  {
    "class": "radio_button_list_control",
    "spacing": 4
  },
  {
    "class": "checkbox_box_control",
    "parents": [{"class": "radio_button_list_control"}, {"class": "checkbox_control"}],
    "content_margin": [13, 13, 0, 0],
    "layer0.texture": "NorberTheme/assets/radio_button_back.png",
    "layer0.tint": "var(radio_back)",
