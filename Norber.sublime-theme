{
"variables": {
// --- Shared ---
  // Color Palette
  "background": "hsl(0, 0%, 16%)",
  "foreground": "hsl(0, 0%, 95%)",
  "foreground_secondary": "hsl(0, 0%, 74%)",

  "accent_ui": "hsl(7, 66%, 53%)",
  "accent_ui_fg": "hsl(5, 79%, 67%)",
  "accent_ui_dimmed": "hsl(6, 40%, 48%)",

  "overlay_bg": "hsl(0, 0%, 26%)",

  // Colors
  "red": "hsl(0, 100%, 50%)",
  "orange": "hsl(32, 80%, 60%)",
  "yellow": "hsl(44, 100%, 60%)",
  "green": "hsl(120, 60%, 60%)",
  "teal": "hsl(180, 60%, 65%)",
  "blue": "hsl(210, 65%, 70%)",
  "purple": "hsl(260, 60%, 75%)",
  "magenta": "hsl(330, 65%, 65%)",

  "dark_red": "color(var(red) s(25%) l(35%))",
  "dark_teal": "color(var(teal) s(25%) l(35%))",
  "medium_gray-light": "hsl(210, 10%, 70%)",
  "medium_gray": "hsl(210, 10%, 50%)",
  "medium_gray-dark": "hsl(210, 10%, 35%)",
  "dark_gray-lightest": "hsl(210, 10%, 19%)",
  "dark_gray-light": "hsl(210, 10%, 16%)",
  "dark_gray-medium": "hsl(210, 10%, 13%)",
  "dark_gray": "hsl(210, 10%, 10%)",

  // Labels
  "font_face": "Verdana",
  "font_size": 12,
  "font_size_sm": 11,
  "font_size_lg": 16,

  // Buttons
  "button_bg": "hsl(0, 0%, 18%)",
  "button_hover_bg": "hsl(0, 0%, 10%)",
  "button_pressed_bg": "hsl(0, 0%, 16%)",
  "close_button_bg": "hsl(0, 0%, 59%)",
  "close_button_hover_bg": "hsl(0, 0%, 83%)",
  "icon_button_fg": "hsl(0, 0%, 100%)",

  // Scollbars
  "scrollbar_bg": "hsl(0, 0%, 20%)",
  "scrollbar_handle_bg": "hsla(0, 0%, 90%, 0.2)",
  "scrollbar_handle_hover_bg": "hsla(0, 0%, 90%, 0.3)",

  // Tabs
  "tabset_bg": "hsl(0, 0%, 35%)",
  "tab_bg": "var(background)",
  "tab_hover_bg": "hsl(0, 0%, 8%)",
  "tab_selected_bg": "hsl(0, 0%, 26%)",
  "tab_dirty_indicator": "hsl(0, 0%, 71%)",
  "tab_fg": "var(foreground_secondary)",
  "tab_selected_fg": "var(foreground)",

  // Sidebar
  "sidebar_bg": "var(background)",
  "sidebar_hover_bg": "hsl(0, 0%, 28%)",
  "sidebar_selected_bg": "hsl(0, 0%, 31%)",
  "sidebar_folder_bg": "hsl(0, 0%, 50%)",
  "sidebar_folder_hover_bg": "hsl(179, 47%, 68%)",
  "sidebar_folder_opened_bg": "var(sidebar_folder_hover_bg)",
  "sidebar_row_expanded_fg": "var(sidebar_folder_hover_bg)",

  // Quick Panel
  "quick_panel_bg": "var(overlay_bg)",
  "quick_panel_fg": "var(foreground)",
  "quick_panel_hover_bg": "hsl(0, 0%, 16%)",
  "quick_panel_path_fg": "var(foreground)",
  "quick_panel_selected_bg": "var(accent_ui_dimmed)",
  "quick_panel_link_fg": "hsl(0, 0%, 100%)",

  // Autocomplete
  "auto_complete_detail_pane_dark_tint": "color(black a(0.1))",
  "auto_complete_detail_pane_light_tint": "color(white a(0.1))",
  "auto_complete_detail_panel_mono_dark_bg": "color(white a(0.12))",
  "auto_complete_detail_panel_mono_light_bg": "color(black a(0.08))",

// --- Sublime Text ---
  // Status Bar
  "status_bar_bg": "hsl(0, 0%, 20%)",
  "status_bar_font": "Consolas",
  "status_bar_font_size": 14,

  // Tabs
  "tabset_button_light_tint": "color(black a(0.5))",

  // VCS
  "vcs_untracked": "grey",
  "vcs_modified": "color(var(--bluish) min-contrast(var(sidebar_bg) 2.5))",
  "vcs_missing": "color(var(--redish) min-contrast(var(sidebar_bg) 2.5))",
  "vcs_staged": "color(var(--bluish) min-contrast(var(sidebar_bg) 2.5))",
  "vcs_added": "color(var(--greenish) min-contrast(var(sidebar_bg) 2.5))",
  "vcs_deleted": "color(var(--redish) min-contrast(var(sidebar_bg) 2.5))",
  "vcs_unmerged": "color(var(--orangish) min-contrast(var(sidebar_bg) 2.5))",

  // Symbols
  "kind_function_color": "var(--redish)",
  "kind_keyword_color": "var(--pinkish)",
  "kind_markup_color": "var(--orangish)",
  "kind_namespace_color": "var(--bluish)",
  "kind_navigation_color": "var(--yellowish)",
  "kind_snippet_color": "var(--greenish)",
  "kind_type_color": "var(--purplish)",
  "kind_variable_color": "var(--cyanish)",
  "kind_name_label_border_color": "color(var(--accent) a(0.8))",
},

"rules": [
// -- Shared --
  // Header
  {
    "class": "title_bar",
    "style": "dark"
  },

  // Labels
  {
    "class": "label_control",
    "color": "var(foreground)",
  },
  {
    "class": "label_control",
    "parents": [{"class": "button_control"}],
    "shadow_color": "transparent",
    "shadow_offset": 0
  },
  // Input labels
  {
    "class": "label_control",
    "parents": [{"class": "panel_control"}],
    "shadow_offset": 0
  },

  // Buttons
  {
    "class": "button_control",
    "layer0.tint": "var(button_bg)",
    "layer0.opacity": 1.0,
    "layer0.inner_margin": [8, 8],
  },
  {
    "class": "button_control",
    "attributes": ["hover"],
    "layer0.tint": "var(button_hover_bg)",
  },
  {
    "class": "button_control",
    "attributes": ["pressed"],
    "layer0.tint": "var(button_pressed_bg)",
  },

  // Scrollbars
  {
    "class": "scroll_bar_control",
    "layer0.tint": "var(scrollbar_bg)",
    "layer0.opacity": 1.0,
    "layer0.inner_margin": 0,
    "blur": true
  },
  {
    "class": "scroll_corner_control",
    "layer0.tint": "var(scrollbar_bg)",
    "layer0.inner_margin": 0,
    "layer0.opacity": 1.0
  },
  {
    "class": "scroll_track_control",
    "layer0.tint": "var(scrollbar_bg)",
    "layer0.opacity": 1.0,
    "layer0.inner_margin": 2,
    "content_margin": 0
  },
  {
    "class": "puck_control",
    "layer0.tint": "var(scrollbar_handle_bg)",
    "layer0.opacity": 1.0,
    "layer0.inner_margin": 2,
    "content_margin": 6,
    "blur": true
  },
  {
    "class": "puck_control",
    "attributes": ["hover"],
    "layer0.tint": "var(scrollbar_handle_hover_bg)",
  },

  // Tabs
  {
    "class": "tabset_control",
    "layer0.tint": "var(tabset_bg)",
    "layer0.opacity": 1.0,
    "content_margin": [0, 0, 0, 0],
    "tab_overlap": 0,
    "tab_width": 70,
    "tab_height": 50,
    "tab_min_width": 30,
    "mouse_wheel_switch": false
  },
  {
    "class": "tabset_control",
    "settings": ["mouse_wheel_switches_tabs"],
    "mouse_wheel_switch": true
  },
  {
    "class": "tabset_control",
    "settings": ["tabs_small"],
    "tab_height": 25
  },
  {
    "class": "tabset_control",
    "settings": ["tabs_medium"],
    "tab_height": 38
  },
  {
    "class": "tabset_control",
    "settings": ["tabs_large"],
    "tab_height": 50
  },
  {
    "class": "tab_control",
    "content_margin": [15, 10],
    "max_margin_trim": 1,
    "hit_test_level": 0.1,

    "layer0.texture": "NorberTheme/assets/tab_background.png",
    "layer0.tint": "var(tab_bg)",
    "layer0.inner_margin": 4,
    "layer0.opacity": 1.0,

    "layer1.texture": "NorberTheme/assets/tab_selected_indicator.png",
    "layer1.inner_margin": [4, 4],
    "layer1.opacity": 0,
  },
  {
    "class": "tab_control",
    "attributes": ["hover"],
    "layer0.tint": "var(tab_hover_bg)",
  },
  {
    "class": "tab_control",
    "attributes": ["selected"],
    "layer0.tint": "var(tab_selected_bg)",
    "layer1.tint": "var(accent_ui)",
    "layer1.opacity": 1.0,
  },
  {
    "class": "tab_control",
    "attributes": ["dirty"],
    "layer1.tint": "var(tab_dirty_indicator)",
    "layer1.opacity": 1.0,
  },

  // Tab Labels
  {
    "class": "tab_label",
    "faded": true,
    "fg": "var(tab_fg)",
    "font.size": "var(font_size)",
    "font.face": "var(font_face)",
    "shadow_offset": 0,
  },
  {
    "class": "tab_label",
    "parents": [{"class": "tab_control", "attributes": ["selected"]}],
    "fg": "var(tab_selected_fg)",
    "shadow_offset": 0
  },
  {
    "class": "tab_label",
    "parents": [{"class": "tab_control", "attributes": ["hover"]}],
    "fg": "var(tab_selected_fg)",
    "shadow_offset": 0
  },
  {
    "class": "tab_label",
    "parents": [{"class": "tab_control", "attributes": ["dirty"]}],
  },
  {
    "class": "tab_label",
    "attributes": ["transient"],
    "font.italic": true
  },

  // Close Button
  {
    "class": "tab_close_button",
    "layer0.texture": "NorberTheme/assets/close.png",
    "layer0.tint": "var(close_button_bg)",
    "layer0.opacity": 1.0
  },
  {
    "class": "tab_close_button",
    "settings": ["show_tab_close_buttons"],
    "content_margin": [8, 8]
  },
  {
    "class": "tab_close_button",
    "parents": [{"class": "tab_control", "attributes": ["dirty"]}],
    "layer0.texture": "NorberTheme/assets/circle.png",
    "layer0.tint": "var(accent_ui)",
    "layer0.opacity": 1.0
  },
  {
    "class": "tab_close_button",
    "settings": ["!show_tab_close_buttons"],
    "parents": [{"class": "tab_control", "attributes": ["dirty"]}],
  },
  {
    "class": "tab_close_button",
    "parents": [{"class": "tab_control", "attributes": ["dirty", "hover"]}],
    "layer0.texture": "NorberTheme/assets/close.png",
    "layer0.opacity": 1.0,
    "layer0.tint": "var(accent_ui)",
  },
  {
    "class": "tab_close_button",
    "settings": ["show_tab_close_buttons"],
    "attributes": ["hover"],
    "layer0.tint": "var(close_button_hover_bg)",
  },
  {
    "class": "tab_close_button",
    "settings": ["show_tab_close_buttons"],
    "attributes": ["hover"],
    "layer0.opacity": 1.0
  },

  // Quick Panel
  {
    "class": "overlay_control",
    "layer0.tint": "var(overlay_bg)",
    "layer0.opacity": 1.0,
    "content_margin": [6, 8, 6, 8],
  },
  {
    "class": "quick_panel",
    "row_padding": [8, 8],
    "layer0.tint": "var(quick_panel_bg)",
    "layer0.opacity": 1.0,
  },
  {
    "class": "text_line_control",
    "layer0.texture": "NorberTheme/assets/text_field_dark.png",
    "layer0.opacity": 1.0,
    "layer0.inner_margin": [4, 3, 4, 2],
    "content_margin": [4, 5, 4, 5],
    "tint_index": 0,
  },
  {
    "class": "text_line_control",
    "parents": [{"class": "overlay_control"}],
    "font.face": "var(font_face)",
    "font.size": "var(font_size)"
  },
  // Rows
  {
    "class": "mini_quick_panel_row",
    "layer0.tint": "var(quick_panel_bg)",
    "layer0.opacity": 1.0
  },
  {
    "class": "mini_quick_panel_row",
    "attributes": ["hover"],
    "layer0.tint": "var(quick_panel_hover_bg)",
  },
  {
    "class": "mini_quick_panel_row",
    "attributes": ["selected"],
    "layer0.tint": "var(quick_panel_selected_bg)",
  },
  {
    "class": "quick_panel_row",
    "layer0.tint": "var(quick_panel_bg)",
    "layer0.inner_margin": 0,
    "layer0.opacity": 1.0
  },
  {
    "class": "quick_panel_row",
    "attributes": ["hover"],
    "layer0.tint": "var(quick_panel_hover_bg)",
  },
  {
    "class": "quick_panel_row",
    "attributes": ["selected"],
    "layer0.tint": "var(quick_panel_selected_bg)",
  },
  {
    "class": "quick_panel_label",
    "fg": "var(quick_panel_fg)",
    "match_fg": "var(quick_panel_fg)",
    "selected_fg": "var(quick_panel_fg)",
    "selected_match_fg": "var(quick_panel_fg)",
  },
  {
    "class": "quick_panel_path_label",
    "fg": "var(quick_panel_path_fg)",
    "match_fg": "var(quick_panel_path_fg)",
    "selected_fg": "var(quick_panel_path_fg)",
    "selected_match_fg": "var(quick_panel_path_fg)",
  },
  {
    "class": "quick_panel_label hint",
    "font.size": "var(font_size_sm)",
    "font.italic": true,
    "fg": "color(var(quick_panel_fg) a(0.8))",
    "selected_fg": "color(var(quick_panel_fg) a(0.8))",
  },
  {
    "class": "quick_panel_label key_binding",
    "font.size": "var(font_size_sm)",
  },
  {
    "class": "quick_panel_label",
    "parents": [{"class": "mini_quick_panel_row"}],
    "fg": "white",
    "font.face": "var(font_face)",
    "font.size": "var(font_size)"
  },

  // Switch Project
  {
    "class": "panel_control",
    "parents": [{"class": "switch_project_window"}],
    "layer0.tint": "var(overlay_bg)",
    "layer0.opacity": 1.0,
  },
  {
    "class": "text_line_control",
    "parents": [{"class": "switch_project_window"}],
    "font.face": "var(font_face)",
    "font.size": "var(font_size)"
  },

  // Tooltips
  {
    "class": "tool_tip_control",
    "layer0.texture": "",
    "layer0.tint": "white",
    "layer0.inner_margin": [1, 1],
    "layer0.opacity": 1.0,
    "content_margin": [5, 5]
  },
  {
    "class": "tool_tip_label_control",
    "color": "black",
  },

  // Auto complete
  {
    "class": "popup_control",
    "content_margin": 1,
    "layer0.tint": "hsl(0, 0%, 20%)",
    "layer0.opacity": 1.0,
  },
  {
    "class": "auto_complete",
    "row_padding": [5, 5]
  },
  {
    "class": "auto_complete_label",
    "fg": "white",
    "match_fg": "white",
    "selected_fg": "white",
    "selected_match_fg": "white",
  },
  {
    "class": "auto_complete_detail_pane",
    "tint_index": 0,
    "layer0.opacity": 1.0,
    "tint_modifier": "var(auto_complete_detail_pane_dark_tint)",
    "content_margin": [8, 5, 8, 5]
  },
  {
    "class": "auto_complete_detail_pane",
    "attributes": ["file_light"],
    "tint_modifier": "var(auto_complete_detail_pane_light_tint)",
  },
  {
    "class": "auto_complete_info",
    "spacing": 8,
  },
  {
    "class": "auto_complete_kind_name_label",
    "font.size": "0.9rem",
    "font.italic": true,
    "border_color": "var(kind_name_label_border_color)"
  },
  {
    "class": "auto_complete_details",
    "monospace_background_color": "var(auto_complete_detail_panel_mono_dark_bg)"
  },
  {
    "class": "auto_complete_details",
    "parents": [{"class": "auto_complete_detail_pane", "attributes": ["file_light"]}],
    "monospace_background_color": "var(auto_complete_detail_panel_mono_light_bg)"
  },
  {
    "class": "annotation_close_button",
    "layer0.texture": "NorberTheme/assets/open_file_close.png",
    "layer0.opacity": 0.8,
    "layer0.tint": "var(foreground)",
    "content_margin": [8, 8],
  },
  {
    "class": "annotation_close_button",
    "attributes": ["hover"],
    "layer0.opacity": 1.0
  },

  // Rows (Autocomplete, Preferences)
  {
    "class": "table_row",
    "layer0.tint": "var(overlay_bg)",
    "layer0.opacity": 1.0,
    "layer0.inner_margin": [5, 5]
  },
  {
    "class": "table_row",
    "attributes": ["selected"],
    "layer0.tint": "var(accent_ui_dimmed)",
  },
  {
    "class": "table_row",
    "attributes": ["hover", "!selected"],
    "layer0.tint": "color(var(overlay_bg) l(+ 15%))",
  },

  // Symbols
  {
    "class": "kind_container",
    // Extra margin on the left makes the
    // italic kind_label look visually centered
    "content_margin": [6, 0, 5, 0],
    "layer0.tint": "var(--background)",
    "layer0.opacity": 0,
    "layer1.tint": "white",
    "layer1.opacity": 0,
  },

// ----------------------------------

// >>> EMPTY WINDOW BACKGROUND
  {
    "class": "sheet_container_control",
    "layer0.tint": "hsl(0, 0%, 33%)",
    "layer0.opacity": 1.0
  },

// >>> GRID LAYOUT
  {
    "class": "grid_layout_control",
    "border_size": 1,
    "border_color": "hsl(0, 0%, 28%)"
  },

// >>> MINI MAP
  {
    "class": "minimap_control",
    "viewport_color": "color(var(accent_ui) a(0.35))"
  },

// >>> TAB SCROLLING
  // Tab dropdown
  {
    "class": "show_tabs_dropdown_button",
    "layer0.texture": "NorberTheme/assets/tab_scroll_dropdown@2x.png",
    "layer0.opacity": 0.6,
    "content_margin": [15, 12]
  },
  {
    "class": "show_tabs_dropdown_button",
    "settings": ["hide_new_tab_button"],
    "content_margin": [13, 12]
  },
  {
    "class": "show_tabs_dropdown_button",
    "settings": {"file_tab_style": ["", "rounded", "square"]},
    "parents": [{"class": "edit_window", "attributes": ["file_light"]}],
    "layer0.tint": "var(tabset_button_light_tint)",
  },
  {
    "class": "show_tabs_dropdown_button",
    "attributes": ["hover"],
    "layer0.opacity": 1.0,
  },

  // Tab scroll left
  {
    "class": "scroll_tabs_left_button",
    "layer0.texture": "NorberTheme/assets/tab_scroll_left@2x.png",
    "layer0.opacity": 0.6,
    "content_margin": [15, 12, 15, 12]
  },
  {
    "class": "scroll_tabs_left_button",
    "settings": ["hide_tab_scrolling_buttons"],
    "content_margin": 0
  },
  {
    "class": "scroll_tabs_left_button",
    "settings": {"file_tab_style": ["", "rounded", "square"]},
    "parents": [{"class": "edit_window", "attributes": ["file_light"]}],
    "layer0.tint": "var(tabset_button_light_tint)",
  },
  {
    "class": "scroll_tabs_left_button",
    "attributes": ["hover"],
    "layer0.opacity": 1.0,
  },

  // Tab scroll right
  {
    "class": "scroll_tabs_right_button",
    "layer0.texture": "NorberTheme/assets/tab_scroll_right@2x.png",
    "layer0.opacity": 0.6,
    "content_margin": [15, 12, 15, 12]
  },
  {
    "class": "scroll_tabs_right_button",
    "settings": ["hide_tab_scrolling_buttons"],
    "content_margin": 0
  },
  {
    "class": "scroll_tabs_right_button",
    "settings": {"file_tab_style": ["", "rounded", "square"]},
    "parents": [{"class": "edit_window", "attributes": ["file_light"]}],
    "layer0.tint": "var(tabset_button_light_tint)",
  },
  {
    "class": "scroll_tabs_right_button",
    "attributes": ["hover"],
    "layer0.opacity": 1.0,
  },


// >>> BUTTONS
  {
    "class": "button_control",
    "content_margin": [4, 9, 4, 10],
    "min_size": [60, 10],
  },

// >>> FOLD BUTTONS
  {
    "class": "fold_button_control",
    "layer0.texture": "NorberTheme/assets/fold_closed.png",
    "layer0.opacity": 1.0,
    "layer0.tint": "var(foreground_secondary)",
    "layer0.inner_margin": 0,
    "content_margin": [8, 8]
  },
  {
    "class": "fold_button_control",
    "attributes": ["expanded"],
    "layer0.texture": "NorberTheme/assets/fold_open.png"
  },
  {
    "class": "fold_button_control",
    "attributes": ["hover"],
    "layer0.tint": "var(accent_ui)",
  },


// >>> SIDEBAR
  // Sidebar container
  {
    "class": "sidebar_container",
    "layer0.tint": "var(sidebar_bg)",
    "layer0.opacity": 1.0,
    "content_margin": [0, -30, 0, 0]
  },
  // Sidebar tree
  {
    "class": "sidebar_tree",
    "row_padding": [10, 8],
    "indent": 18,
    "indent_offset": 0,
    "indent_top_level": false,
    "layer0.tint": "var(sidebar_bg)",
    "layer0.opacity": 1.0,
  },
  // Sidebar rows
  {
    "class": "tree_row",
    "layer0.tint": "var(sidebar_bg)",
    "layer0.opacity": 1.0,
  },
  // Sidebar row hover
  {
    "class": "tree_row",
    "attributes": ["hover"],
    "layer0.tint": "var(sidebar_hover_bg)",
  },
  // Sidebar row selected
  {
    "class": "tree_row",
    "attributes": ["selected"],
    "layer0.tint": "var(sidebar_selected_bg)",
  },
  // Sidebar row hover selected
  {
    "class": "tree_row",
    "attributes": ["hover", "selected"],
    "layer0.tint": "var(sidebar_hover_bg)",
  },
  // Sidebar heading
  {
    "class": "sidebar_heading",
    "color": "hsl(0, 0%, 76%)",
    "font.bold": true,
    "font.size": "var(font_size)",
    "shadow_offset": 0
  },
  // Sidebar heading selected
  {
    "class": "sidebar_heading",
    "parents": [{"class": "tree_row", "attributes": ["selected"]}]
  },
  // Sidebar entry
  {
    "class": "sidebar_label",
    "color": "var(foreground)",
    "font.size": "var(font_size)",
    "font.face": "var(font_face)",
    "font.bold": false
  },
  // Sidebar folder entry
  {
